# KlikZarada V11 production example
KLIKZARADA_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./klikzarada_v11.db
# For production use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/klikzarada
APP_ENV=production
# Create the first production administrator once. Keep the password only in Render.
ADMIN_BOOTSTRAP_NAME=Vlasnik platforme
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Production has no demo accounts. Enable only for local development.
KLIKZARADA_SEED_DEMO=false

# Anti-fraud. The pepper HMAC-hashes device and IP signals before storage.
# Set a unique random value in Render; never reuse or commit a real value.
KLIKZARADA_FRAUD_PEPPER=
# Per-user limits are enforced by the server before a proof can be submitted.
ANTI_FRAUD_DAILY_TASK_LIMIT=20
ANTI_FRAUD_DAILY_EARNINGS_RSD=2000
ANTI_FRAUD_MIN_TASK_SECONDS=30
ANTI_FRAUD_MAX_TASK_SECONDS=600
ANTI_FRAUD_MIN_ACTIVITY_EVENTS=8
# Optional IP/VPN/proxy reputation provider. The platform still works without it.
IPQUALITYSCORE_API_KEY=

# PayPal Live Checkout. Keep all real values outside Git and enter them in Render.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Standard PayPal card checkout is enabled by default. Set false only to hide it.
# PayPal still decides whether a buyer/account is eligible to see card checkout.
PAYPAL_CARD_PAYMENTS_ENABLED=true
# The RSD value of one EUR used to show internal budget before PayPal charges EUR.
PAYPAL_RSD_PER_EUR=
# PayPal does not support RSD as a payout currency. Keep this disabled until
# the PayPal account has Payouts access and the administrator is ready to test.
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_PAYOUT_CURRENCY=EUR
# Used only for user payouts; choose and document the approved conversion rate.
PAYPAL_PAYOUT_RSD_PER_EUR=
# Example: https://klikzarada.onrender.com
PUBLIC_APP_URL=
APP_BASE_URL=https://your-domain.rs
# Banner upload. Without a persistent Render Disk or object storage, files in
# the default app directory are removed by a redeploy. Set this to a mounted
# persistent path before accepting production creative uploads.
BANNER_UPLOAD_DIR=app/static/uploads/banners
# Email delivery is inactive until all SMTP variables are present in Render.
# Never commit real credentials; use a transactional provider in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
# SMTP_USER and SMTP_FROM are accepted as compatibility aliases, but use the
# names above for all new Render configuration.
ADMIN_EMAIL=admin@klikzarada.rs
# Configure an external error-monitoring DSN and a scheduled PostgreSQL backup
# destination before public launch. The application keeps normal audit logs,
# but these variables alone do not create an external backup or monitoring job.
ERROR_MONITORING_DSN=
# Set a protected object-storage destination or configure Render's managed
# PostgreSQL backup and set RENDER_POSTGRES_BACKUP_ENABLED=true.
DATABASE_BACKUP_URL=
RENDER_POSTGRES_BACKUP_ENABLED=false
