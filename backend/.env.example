DATABASE_URL=sqlite:///./food_saver.db
APP_NAME=Food Saver Serbia MVP

# Payment provider: paypal, pay_on_pickup, ips_qr, monri_wspay, demo
PUBLIC_BASE_URL=http://127.0.0.1:8000
PAYMENT_PROVIDER=paypal
PAYMENT_ADMIN_SECRET=change-me

# PayPal MVP provider. Use a PayPal Business email. App prices are in RSD; PayPal amount is converted to EUR by PAYPAL_RSD_TO_EUR_RATE.
PAYPAL_MODE=live
PAYPAL_BUSINESS_EMAIL=
PAYPAL_CURRENCY=EUR
PAYPAL_RSD_TO_EUR_RATE=117.0

# IPS/NBS QR merchant data. Set MERCHANT_ACCOUNT to a real Serbian business account before real payments.
MERCHANT_NAME=Food Saver Serbia DOO
MERCHANT_ADDRESS=Beograd
MERCHANT_ACCOUNT=
MERCHANT_PAYMENT_CODE=189
MERCHANT_PAYMENT_PURPOSE=Food Saver rezervacija {code}
PAYMENT_REFERENCE_PREFIX=FS

# Monri/WSPay provider-ready config. Add official credentials after merchant activation.
MONRI_MODE=sandbox
MONRI_CHECKOUT_URL=
MONRI_MERCHANT_ID=
MONRI_SECRET_KEY=
MONRI_SUCCESS_URL=http://127.0.0.1:8000/reservation
MONRI_CANCEL_URL=http://127.0.0.1:8000/reservation

# V33 Admin security
ADMIN_PIN=246810
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false

# V34 SMS / notifications
SMS_ENABLED=true
SMS_PROVIDER=mock
SMS_DRY_RUN=true
CUSTOMER_SMS_NOTIFICATIONS=true
SELLER_SMS_NOTIFICATIONS=false
DEV_SHOW_OTP=true
CUSTOMER_OTP_TTL_MINUTES=10
CUSTOMER_TOKEN_TTL_DAYS=30
SMS_SENDER=FoodSaver
SMS_OTP_TEMPLATE=Food Saver kod za prijavu je {code}. Važi 10 minuta.

# For a real HTTP SMS gateway, set SMS_PROVIDER=http_api and SMS_DRY_RUN=false.
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_TIMEOUT_SECONDS=10

# V35 production readiness settings
PLATFORM_COMMISSION_PERCENT=25
ADMIN_PIN=246810
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false

# SMS / OTP
SMS_PROVIDER=mock
SMS_ENABLED=true
SMS_DRY_RUN=true
DEV_SHOW_OTP=true
CUSTOMER_SMS_NOTIFICATIONS=true
SELLER_SMS_NOTIFICATIONS=false
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=FoodSaver

# Payment provider
PAYMENT_PROVIDER=paypal
PUBLIC_BASE_URL=http://127.0.0.1:8000
MERCHANT_NAME=Food Saver Serbia DOO
MERCHANT_ADDRESS=Beograd
MERCHANT_ACCOUNT=
MERCHANT_PAYMENT_CODE=189
MERCHANT_PAYMENT_PURPOSE=Food Saver rezervacija {code}
PAYMENT_REFERENCE_PREFIX=FS

APP_ENV=local
# V52 speed/live flow
# Keep false for live customer/seller actions. Use manual Excel export from admin when needed.
EXCEL_AUTOSAVE=false

# Commission model when online payment is not used:
# - paypal/ips_qr/demo: platform collects payment first, seller gets net after 25% fee.
# - pay_on_pickup: seller collects from customer, platform fee becomes commission_due in Finance.
COMMISSION_COLLECTION_MODEL=platform_collects_or_seller_invoice
