def print_invoice(invoice_id: int, db: Session = Depends(get_db)):
    invoice = db.get(SellerInvoice, invoice_id)
    if not invoice: return _html("<h1>Račun nije pronađen</h1>")
    seller = db.get(Store, invoice.seller_id)
    lines = db.query(SellerInvoiceLine).filter(SellerInvoiceLine.invoice_id == invoice_id).all()
    payments = db.query(SellerInvoicePayment).filter(SellerInvoicePayment.seller_invoice_id == invoice_id).all()
    lines_html = "".join([f"<tr><td>{l.description or '-'}</td><td>{l.line_type or '-'}</td><td>{money_sr(l.total_amount, l.currency)}</td></tr>" for l in lines]) or "<tr><td colspan='3'>Nema stavki.</td></tr>"
    payments_html = "".join([f"<tr><td>{p.provider or '-'}</td><td>{status_sr(p.status)}</td><td>{money_sr(p.amount, p.currency)}</td><td>{date_sr(p.payment_date or p.received_at)}</td></tr>" for p in payments]) or "<tr><td colspan='4'>Nema evidentiranih uplata.</td></tr>"
    html = f"""<!doctype html><html lang='sr'><head><meta charset='utf-8'><title>Račun {invoice.invoice_number}</title><style>body{{font-family:Arial;margin:36px;color:#172017}}.top{{display:flex;justify-content:space-between;border-bottom:2px solid #246b45;padding-bottom:18px;margin-bottom:24px}}h1{{margin:0;color:#246b45}}table{{width:100%;border-collapse:collapse;margin-top:12px}}th,td{{border-bottom:1px solid #ddd;padding:10px;text-align:left}}th{{background:#f0f5ee}}.total{{font-size:22px;font-weight:800}}.badge{{display:inline-block;background:#eef4ec;border-radius:999px;padding:6px 10px;font-weight:800}}@media print{{button{{display:none}}}}</style></head><body><button onclick='window.print()'>Štampaj / Sačuvaj kao PDF</button><div class='top'><div><h1>Sačuvaj Hranu</h1><p>Finansijski obračun provizije</p></div><div><h2>Račun {invoice.invoice_number}</h2><p><span class='badge'>{status_sr(invoice.status)}</span></p></div></div><p><b>Partner:</b> {seller.name if seller else 'Partner #' + str(invoice.seller_id)}<br><b>Period:</b> {date_sr(invoice.period_start)} — {date_sr(invoice.period_end)}<br><b>Datum dospeća:</b> {date_sr(invoice.due_date)}</p><h2>Pregled</h2><p class='total'>Ukupno: {money_sr(invoice.total_amount, invoice.currency)}</p><p>Plaćeno: {money_sr(invoice.amount_paid, invoice.currency)}<br>Dug: {money_sr(invoice.amount_due, invoice.currency)}</p><h2>Stavke računa</h2><table><thead><tr><th>Opis</th><th>Tip</th><th>Iznos</th></tr></thead><tbody>{lines_html}</tbody></table><h2>Uplate</h2><table><thead><tr><th>Provider</th><th>Status</th><th>Iznos</th><th>Datum</th></tr></thead><tbody>{payments_html}</tbody></table></body></html>"""
    return _html(html)
