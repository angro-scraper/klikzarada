@app.middleware("http")
async def excel_autosave_middleware(request, call_next):
    """Autosave Excel backup without slowing critical customer/seller actions.

    Earlier MVP builds exported the entire Excel database after every POST/PATCH.
    That made reservation creation and payment-option saving feel slow.
    V52 keeps manual Excel export available, but skips autosave for fast live flows.
    """
    response = await call_next(request)
    autosave = os.getenv("EXCEL_AUTOSAVE", "false").lower() in {"1", "true", "yes", "da"}
    mutating_method = request.method.upper() in {"POST", "PATCH", "PUT", "DELETE"}
    fast_live_prefixes = (
        "/reservations",
        "/payments",
        "/seller-api",
        "/customers",
        "/finance",
        "/uploads",
        "/notifications",
        "/v45",
        "/v48",
    )
    skip_path = request.url.path.startswith("/excel-database") or request.url.path.startswith(fast_live_prefixes)
    if autosave and mutating_method and response.status_code < 400 and not skip_path:
        try:
            db = SessionLocal()
            export_database_to_excel(db)
        except Exception:
            pass
        finally:
            try:
                db.close()
            except Exception:
                pass
    return response

