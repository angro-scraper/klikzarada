# Lightweight SQLite migration for users who reuse an older local food_saver.db.
# In production, replace this with Alembic migrations.
try:
    if str(engine.url).startswith("sqlite"):
        with engine.begin() as conn:
            rows = conn.execute(text("PRAGMA table_info(stores)")).fetchall()
            columns = {row[1] for row in rows}
            if "seller_pin" not in columns:
                conn.execute(text("ALTER TABLE stores ADD COLUMN seller_pin VARCHAR(20)"))
                conn.execute(text("UPDATE stores SET seller_pin = printf('%06d', abs(random()) % 1000000) WHERE seller_pin IS NULL"))
            if "latitude" not in columns:
                conn.execute(text("ALTER TABLE stores ADD COLUMN latitude FLOAT"))
            if "longitude" not in columns:
                conn.execute(text("ALTER TABLE stores ADD COLUMN longitude FLOAT"))

            reservation_rows = conn.execute(text("PRAGMA table_info(reservations)")).fetchall()
            reservation_columns = {row[1] for row in reservation_rows}
            reservation_additions = {
                "payment_status": "VARCHAR(60) DEFAULT 'unpaid'",
                "payment_provider": "VARCHAR(80) DEFAULT 'demo'",
                "payment_method": "VARCHAR(80) DEFAULT 'online_card_demo'",
                "payment_reference": "VARCHAR(120)",
                "currency": "VARCHAR(10) DEFAULT 'RSD'",
                "gross_amount": "FLOAT DEFAULT 0",
                "loyalty_discount_percent": "FLOAT DEFAULT 0",
                "loyalty_discount_amount": "FLOAT DEFAULT 0",
                "payable_amount": "FLOAT DEFAULT 0",
                "platform_fee_percent": "FLOAT DEFAULT 25",
                "platform_fee_amount": "FLOAT DEFAULT 0",
                "seller_net_amount": "FLOAT DEFAULT 0",
                "paid_at": "DATETIME",
                "seller_payout_status": "VARCHAR(60) DEFAULT 'not_ready'",
                "seller_payout_reference": "VARCHAR(160)",
                "seller_payout_note": "TEXT",
                "seller_payout_at": "DATETIME",
            }
            for col, definition in reservation_additions.items():
                if col not in reservation_columns:
                    conn.execute(text(f"ALTER TABLE reservations ADD COLUMN {col} {definition}"))
except Exception:
    pass

