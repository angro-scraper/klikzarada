# Sačuvaj Hranu - produkcija .env primer
APP_NAME=Sačuvaj Hranu
APP_ENV=production
PRODUCTION_MODE=true

# Hosting / domen
PUBLIC_BASE_URL=https://tvoj-domen.rs
ALLOWED_ORIGINS=https://tvoj-domen.rs

# Baza - za javni live koristi PostgreSQL ili MySQL/MariaDB na AdriaHost-u
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# AdriaHost/MySQL primer:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4

# Admin zaštita
ADMIN_GUARD_ENABLED=true
ADMIN_PIN=promeni-ovaj-pin
ADMIN_SESSION_SECRET=promeni-ovo-u-dugacak-random-secret-minimum-32-karaktera
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=true

# Prvi live model - preporuka za zatvoreni pilot
PAYMENT_PROVIDER=pay_on_pickup
PLATFORM_COMMISSION_PERCENT=25
COMMISSION_COLLECTION_MODEL=seller_invoice

# Ako se uključi IPS QR
MERCHANT_NAME=Sačuvaj Hranu
MERCHANT_ADDRESS=Beograd
MERCHANT_ACCOUNT=
MERCHANT_PAYMENT_CODE=189
MERCHANT_PAYMENT_PURPOSE=Sačuvaj Hranu rezervacija {code}
PAYMENT_REFERENCE_PREFIX=SH

# SMS/email provider
SMS_ENABLED=true
SMS_PROVIDER=mock
SMS_DRY_RUN=true
CUSTOMER_SMS_NOTIFICATIONS=false
SELLER_SMS_NOTIFICATIONS=false
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
DEV_SHOW_OTP=false

# Backup / lokalizacija
EXCEL_AUTOSAVE=false
DEFAULT_LOCALE=sr-RS
UI_LANGUAGE=sr
FINANCE_CONSOLE_LANGUAGE=sr
